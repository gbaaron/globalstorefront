{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "netlify-cli",
        "dev",
        "--dir",
        "."
      ],
      "port": 8888
    },
    {
      "name": "static",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8889"
      ],
      "port": 8889
    },
    {
      "name": "petrinos",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--directory",
        "../Petrinos Pizza"
      ],
      "port": 8765
    },
    {
      "name": "gbfinance",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8892",
        "--directory",
        "../gb_finance_tracker/data"
      ],
      "port": 8892
    },
    {
      "name": "globalmedia",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8899",
        "--directory",
        "../Global Media"
      ],
      "port": 8899
    }
  ]
}