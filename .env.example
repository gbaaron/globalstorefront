# Global Storefront — environment variables
# Copy to .env and fill in. Never commit .env.

# --- required ---------------------------------------------------------------
AIRTABLE_API_KEY=pat...
AIRTABLE_BASE_ID=appFruyJCRi9Fj6qX
JWT_SECRET=<random 32+ characters>
OPENAI_API_KEY=sk-...            # the universal helper bot (gpt-3.5-turbo)

# --- passwords --------------------------------------------------------------
# LEAVE UNSET WHILE BUILDING. Plain-text passwords are deliberate during a spec
# build: hashing is one-way, so a password typed into Airtable to test a screen
# cannot be read back, and a login that silently upgrades a hand-seeded row
# makes that password single-use.
#
# >>> SET THIS TO 1 BEFORE THE FIRST REAL MEMBER SIGNS UP. <<<
# The directory adds a second, much larger population — ordinary shoppers, who
# reuse passwords everywhere. Flip it before a region goes public, then run
# `node scripts/reset-passwords.js --rehash`.
# An existing hash is honoured either way, so toggling locks nobody out.
# HASH_PASSWORDS=1

# --- admin ------------------------------------------------------------------
ADMIN_EMAIL=globallyballinspam@gmail.com
ADMIN_PASSWORD=<header-auth admin password>

# --- deferred: nothing moves until these are set ----------------------------
# STRIPE_SECRET_KEY=sk_...       # without it, billing is records-only
# STRIPE_WEBHOOK_SECRET=whsec_...
# FIREBASE_SERVER_KEY=...        # without it, push resolves recipients but transmits nothing
# RESEND_API_KEY=re_...          # or SENDGRID_API_KEY; without either, campaigns are records-only
# CAMPAIGN_FROM_EMAIL=hello@...
